# Copy to .env and fill in values.

# Optional: override repo root when scripts run from elsewhere
# JOBSEARCH_ROOT=/absolute/path/to/Gemini-jobsearch

# Gemini (used by scripts/classify_and_save.py when present)
GEMINI_API_KEY=

# HTTP port for dashboard_server.py (default 8080)
# JOBSEARCH_DASHBOARD_PORT=8081

# Docker Compose only: host ports if 8080 / 3000 are already in use on your machine
# JOBSEARCH_API_HOST_PORT=8081
# JOBSEARCH_WEB_HOST_PORT=3001

# Discord / Slack-style incoming webhook (preferred over storing in config.json)
JOBSEARCH_WEBHOOK_URL=

# Two-way Discord Bot configuration
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Supabase (dashboard_server, migrate_to_supabase, scripts/sync_jobs_to_supabase.py)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=   # optional; for JWT verification in dashboard_server

# Optional: publish merged local jobs to Supabase when running scripts/run_pipeline.sh
# (dashboard or `make docker-pipeline`) — must match the logged-in user
# MAAS_USER_ID=
# MAAS_USER_EMAIL=

