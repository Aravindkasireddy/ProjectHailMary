# Copy to .env and fill in values.

# Optional: override repo root when scripts run from elsewhere
# JOBSEARCH_ROOT=/absolute/path/to/Gemini-jobsearch

# Gemini (used by scripts/classify_and_save.py when present)
GEMINI_API_KEY=

# Notion (dashboard_server.py and save_to_notion.py)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Discord / Slack-style incoming webhook (preferred over storing in config.json)
JOBSEARCH_WEBHOOK_URL=
