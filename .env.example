# Copy to .env and fill in values.

# Optional: override repo root when scripts run from elsewhere
# JOBSEARCH_ROOT=/absolute/path/to/Gemini-jobsearch

# Gemini (used by scripts/classify_and_save.py when present)
GEMINI_API_KEY=

# HTTP port for dashboard_server.py (default 8080)
# JOBSEARCH_DASHBOARD_PORT=8081

# Docker Compose only: nginx listens on port 80; override if that port is busy
# NGINX_HOST_PORT=8090
# NEXT_PUBLIC_API_URL defaults to /api (same-origin via nginx); only override if
# running the API on a separate host entirely (e.g. staging split-deploy)
# NEXT_PUBLIC_API_URL=https://api.example.com

# Pipeline thread-pool caps (find_and_scrape_jobs.py). Docker defaults are already low
# (outer/inner/scrape = 2). Lower further if you still see "can't start new thread".
# JOBSEARCH_MAX_WORKERS=2
# JOBSEARCH_OUTER_WORKERS=2
# JOBSEARCH_INNER_WORKERS=2
# JOBSEARCH_SCRAPE_WORKERS=2

# Discord / Slack-style incoming webhook (preferred over storing in config.json)
JOBSEARCH_WEBHOOK_URL=

# Two-way Discord Bot configuration
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Supabase (dashboard_server, migrate_to_supabase, scripts/sync_jobs_to_supabase.py)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=   # optional; for JWT verification in dashboard_server

# Optional: publish merged local jobs to Supabase when running scripts/run_pipeline.sh
# (dashboard or `make docker-pipeline`) — must match the logged-in user
# MAAS_USER_ID=
# MAAS_USER_EMAIL=

